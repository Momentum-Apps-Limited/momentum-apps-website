# Copy to .env for local builds. Never commit real values.
# Cloudflare Pages: set these in Settings → Environment variables
# for both Production and Preview.

# Public site key. Must be available at BUILD time (it is written into the static pages).
TURNSTILE_SITE_KEY=

# Secret. Used only by the Pages Function at request time.
TURNSTILE_SECRET_KEY=

# Secret. Used only by the Pages Function at request time.
RESEND_API_KEY=

# Optional. Must be an address on a domain you have verified in Resend.
# RESEND_FROM=Momentum Apps <website@momentum-apps.com>
