---
import { policyLinks, type AppEntry } from "../data/apps";
import { isCurrent } from "../lib/urls";

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
const links = policyLinks(app).filter((link) => link.label !== "Overview");
const path = Astro.url.pathname;
---

{
  links.length > 0 && (
    <nav class="doc-links" aria-label={`${app.name} documents`}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(path, link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  )
}
