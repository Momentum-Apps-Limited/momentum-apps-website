---
import { appFromPath, policyLinks } from "../data/apps";
import { canonicalPath, isCurrent } from "../lib/urls";

const path = canonicalPath(Astro.url.pathname);
const app = appFromPath(path);
const onContact = path === "/contact";
const links = app
  ? policyLinks(app)
  : [
      { href: "/#apps", label: "Apps" },
      { href: "/#about", label: "About" },
      { href: "/contact.html", label: "Contact" },
    ];
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/">
      <img src="/logo.png" width="44" height="44" alt="" />
      <span>Momentum Apps</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Open menu</span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label={app ? `${app.name} pages` : "Primary"}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              (app ? isCurrent(path, link.href) : link.href === "/contact.html" && onContact)
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  const label = button?.querySelector(".sr-only");

  function setOpen(open: boolean) {
    if (!button || !nav || !label) return;
    button.setAttribute("aria-expanded", String(open));
    nav.classList.toggle("is-open", open);
    label.textContent = open ? "Close menu" : "Open menu";
  }

  button?.addEventListener("click", () => {
    setOpen(button.getAttribute("aria-expanded") !== "true");
  });

  nav?.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof HTMLAnchorElement) setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
</script>
