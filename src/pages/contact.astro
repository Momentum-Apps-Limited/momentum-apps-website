---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Base
  title="Contact | Momentum Apps"
  description="Contact Momentum Apps Limited for support, feedback, or partnerships. We usually reply within 2 business days."
>
  <section class="page-intro">
    <div class="container">
      <h1>Contact Momentum Apps</h1>
      <p class="lead">Tell us what you need. The note goes to support@momentum-apps.com.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</Base>
