---
import Base from "../../../layouts/Base.astro";
import PlayBadge from "../../../components/PlayBadge.astro";
import PromoSection from "../../../components/PromoSection.astro";
import ScreenshotGallery from "../../../components/ScreenshotGallery.astro";
import { apps, type AppEntry } from "../../../data/apps";

export function getStaticPaths() {
  return apps
    .filter((app): app is AppEntry & { slug: string } => Boolean(app.slug))
    .map((app) => ({
      params: { app: app.slug },
      props: { app },
    }));
}

interface Props {
  app: AppEntry & { slug: string };
}

const { app } = Astro.props;
---

<Base title={`${app.name} | Momentum Apps`} description={app.summary}>
  <section class="app-hero">
    <div class="container">
      <p class="kicker">
        {app.platform}
        <span aria-hidden="true">·</span>
        {app.status === "live" ? "Live" : "Coming soon"}
      </p>
      <h1>{app.name}</h1>
      <p class="lead">{app.summary}</p>
      {
        app.status === "soon" && (
          <p class="soon-note">Coming soon for {app.platform}. There is no store listing yet.</p>
        )
      }
      <div class="actions">
        {app.playUrl && <PlayBadge href={app.playUrl} />}
        <a class="btn btn-secondary" href="/#apps">All apps</a>
      </div>
      {
        app.screenshots.length > 0 && (
          <div class="app-shots">
            <ScreenshotGallery
              screenshots={app.screenshots}
              name={app.name}
              variant={app.platform === "Web" ? "browser" : "phone"}
            />
          </div>
        )
      }
    </div>
  </section>

  {
    app.promo?.map((block, index) => (
      <div class="section">
        <div class="container">
          <PromoSection block={block} flip={index % 2 === 1} />
        </div>
      </div>
    ))
  }
</Base>
