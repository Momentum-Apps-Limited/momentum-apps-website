---
import Base from "../../../layouts/Base.astro";
import { apps, appDoc, type AppEntry } from "../../../data/apps";
import { isCurrent } from "../../../lib/urls";

export function getStaticPaths() {
  return apps
    .filter((app): app is AppEntry & { slug: string } => Boolean(app.slug))
    .map((app) => ({
      params: { app: app.slug },
      props: { app },
    }));
}

interface Props {
  app: AppEntry & { slug: string };
}

const { app } = Astro.props;
const pages = [
  { href: `/apps/${app.slug}/`, label: "Overview" },
  { href: appDoc(app.slug, "help"), label: "Help" },
  { href: appDoc(app.slug, "privacy"), label: "Privacy" },
  { href: appDoc(app.slug, "terms"), label: "Terms" },
  ...(app.extraPages ?? []).map((page) => ({
    href: appDoc(app.slug, page.page),
    label: page.label,
  })),
];
const path = Astro.url.pathname;
---

<Base title={`${app.name} | Momentum Apps`} description={app.summary}>
  <section class="app-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#apps">Apps</a>
        <span aria-hidden="true">/</span>
        <span>{app.name}</span>
      </nav>
      <p class="kicker">{app.platform}</p>
      <h1>{app.name}</h1>
      <p class="lead">{app.summary}</p>
      {
        app.status === "soon" && (
          <p class="soon-note">Coming soon for {app.platform}. There is no store listing yet.</p>
        )
      }
      <div class="actions">
        {
          app.status === "live" && (
            <a class="btn btn-primary" href={app.href} target="_blank" rel="noopener noreferrer">
              Get it on Google Play<span class="sr-only"> (opens in a new tab)</span>
            </a>
          )
        }
        <a class="btn btn-secondary" href="/#apps">All apps</a>
      </div>
      <nav class="doc-nav" aria-label={`${app.name} pages`}>
        {
          pages.map((page) => (
            <a href={page.href} aria-current={isCurrent(path, page.href) ? "page" : undefined}>
              {page.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="shots">
        {
          app.screenshots.map((shot) => (
            <li>
              <img src={shot.src} width={shot.width} height={shot.height} alt={shot.alt} />
            </li>
          ))
        }
      </ul>
      <ul class="feature-list">
        {app.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </div>
  </section>
</Base>
