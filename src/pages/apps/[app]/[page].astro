---
import { readFileSync } from "node:fs";
import path from "node:path";
import Base from "../../../layouts/Base.astro";
import AppDocLinks from "../../../components/AppDocLinks.astro";
import { apps, appHome } from "../../../data/apps";
import { legacyDocs } from "../../../data/legacy";

export function getStaticPaths() {
  return legacyDocs.map((doc) => ({
    params: { app: doc.app, page: doc.page },
    props: { doc },
  }));
}

interface Props {
  doc: (typeof legacyDocs)[number];
}

const { doc } = Astro.props;
const app = apps.find((entry) => entry.slug === doc.app);
const html = readFileSync(path.join(process.cwd(), "src/content/legacy", doc.file), "utf8");
---

<Base title={doc.title} description={doc.description}>
  <section class="page-intro">
    <div class="container">
      {
        app && (
          <a class="app-back" href={appHome(doc.app)}>
            {app.name}
          </a>
        )
      }
    </div>
  </section>
  <article class="container prose" set:html={html} />
  {
    app && (
      <div class="container app-docs">
        <AppDocLinks app={app} />
      </div>
    )
  }
</Base>
