---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | Momentum Apps"
  description="That page is not on the Momentum Apps website."
  noindex={true}
>
  <section class="page-intro">
    <div class="container narrow">
      <h1>That page is not here.</h1>
      <p class="lead">The link may be out of date. The apps and their privacy, terms, and help pages are still on this site.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-secondary" href="/contact.html">Contact us</a>
      </div>
    </div>
  </section>
</Base>
